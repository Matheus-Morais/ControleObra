# --- App (obrigatório) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Automação de migrations (opcional; usado por `npm run db:migrate`) ---
# Opção recomendada: Personal Access Token (Management API), 1 clique em
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# Opção alternativa: connection string COM SENHA (porta 5432, não o pooler 6543)
# SUPABASE_DB_URL=postgresql://postgres:SENHA@db.your-ref.supabase.co:5432/postgres

# --- Automação de deploy (opcional; usado por `npm run deploy` via Vercel CLI) ---
# Token pessoal em https://vercel.com/account/tokens (o CLI o lê automaticamente).
# O deploy também acontece ao dar `git push` se o repo estiver conectado ao
# Vercel (integração Git) — nesse caso este token é dispensável.
# VERCEL_TOKEN=your-vercel-token
